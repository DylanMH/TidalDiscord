# Copy to .env and fill in real values for local development.
# NEVER commit your real .env — it is gitignored.

TIDAL_CLIENT_ID=your_client_id_here
TIDAL_CLIENT_SECRET=your_client_secret_here

ASPNETCORE_ENVIRONMENT=Development
PORT=8080

# Optional tuning
# RATE_LIMIT_PERMIT=60
# RATE_LIMIT_WINDOW_SECONDS=60
